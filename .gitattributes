# Keep text consistent across platforms, regardless of core.autocrlf.
* text=auto eol=lf

# Preserve binary assets byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
